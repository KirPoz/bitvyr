+/** @brief Cold stream reservation до первых RX/INIT и tasks; OOM освобождает только known allocations. */
+static int nes_raw_reserve_stream(void)
+{
+#if H_SDIO_HOST_RX_MODE == H_SDIO_HOST_STREAMING_MODE
+	const unsigned count = H_SDIO_RX_DOUBLE_BUFFERING ? 2U : 1U;
+	for (unsigned i = 0; i < count; ++i) {
+		double_buf.buffer[i].buf = (uint8_t *)g_h.funcs->_h_malloc_align(NES_RAW_STREAM_BYTES, HOSTED_MEM_ALIGNMENT);
+		if (!double_buf.buffer[i].buf) {
+			for (unsigned j = 0; j < i; ++j) {
+				g_h.funcs->_h_free_align(double_buf.buffer[j].buf);
+				double_buf.buffer[j].buf = NULL;
+				double_buf.buffer[j].buf_size = 0;
+			}
+			return 0;
+		}
+		double_buf.buffer[i].buf_size = NES_RAW_STREAM_BYTES;
+	}
+#endif
+	return 1;
+}
