    unity_0_cxx:_ZN3nes4core7MachineC1Ev (default)
    unity_0_cxx:_ZN3nes4core7MachineC2Ev (default)
    # Кадровый packet dispatch исполняется на CPU0, вне waveform/DSP kernels.
    unity_0_cxx:_ZN3nes4core13AudioRenderer6renderERKNS0_11AudioPacketE (default)

