    unity_0_cxx:_ZN3nes4core7Machine10audioResetEv (default)
    unity_0_cxx:_ZN3nes4core9TimingApu5resetEb (default)

    # Setup/input раз в кадр и load/reset control; execution kernels остаются в SRAM.
    unity_0_cxx:_ZN3nes4core7Machine17audioClearSamplesEv (default)
    unity_0_cxx:_ZN3nes4core7Machine13setControllerEjh (default)
    unity_0_cxx:_ZN3nes4core9Legacy1605resetEjj (default)
    # Проверки audio status/control находятся вне oscillator/FIR kernels.
    unity_0_cxx:_ZN3nes4core3Apu10readStatusEv (default)
    # APU конструируется при инициализации приложения/ресурсов.
    unity_0_cxx:_ZN3nes4core3ApuC1ERNS0_6ApuBusE (default)
    unity_0_cxx:_ZN3nes4core3ApuC2ERNS0_6ApuBusE (default)
    # Envelope/linear/length/sweep controls секвенсора; oscillator/FIR kernels остаются в SRAM.
    unity_0_cxx:_ZN3nes4core3Apu12quarterFrameEv (default)
    unity_0_cxx:_ZN3nes4core3Apu9halfFrameEv (default)
    # Только indexed observer/fallback; обычная RGB-специализация остаётся в SRAM.
    unity_0_cxx:_ZN3nes4core13VideoRenderer19backgroundRunPixelsILb0EEENS0_17VideoRenderResultERKNS0_10VideoEventEPS5_jj (default)
    # Перестроение PRG mapping при cartridge writes; CPU execution kernels остаются в SRAM.
    unity_0_cxx:_ZN3nes4core9Cartridge15refreshPrgPagesEv (default)
    # Только renderer triangle segment CPU0; CPU1 timing и FIR kernels остаются в SRAM.
    unity_0_cxx:_ZN3nes4core3Apu24advanceRendererCpuCyclesEjb (nes_apu_renderer_cached_text_only)
    # Literal-cache trial: compiler/API и CPU0 control/indexed пути.
    unity_0_cxx:_ZN3nes4core7Cpu650219compileLiteralBlockERNS0_12LiteralCacheEtPKh (default)
